<Window x:Class="MovieCatalogue.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Catalogue" 
        Height="900" 
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        xmlns:converters="clr-namespace:MovieCatalogue.UI.Converters">

    <Window.Resources>
        <converters:PosterPathToImageSourceConverter x:Key="PosterPathToImageSourceConverter"/>

        <!-- Movie Card Template -->
        <DataTemplate x:Key="MovieCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="154" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Movie Poster -->
                    <Border Grid.Column="0" 
                            Width="154" 
                            Height="231" 
                            CornerRadius="8" 
                            Background="{DynamicResource SurfaceVariantBrush}"
                            Margin="-12,-12,16,-12">
                        <Image Stretch="UniformToFill" 
                               Width="154" 
                               Height="231"
                               Source="{Binding PosterUrl, Converter={StaticResource PosterPathToImageSourceConverter}}"/>
                    </Border>

                    <!-- Movie Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <!-- Title and Year -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" 
                                       FontSize="22" 
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock FontSize="16" 
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                       Margin="12,0,0,0" 
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="({0:yyyy})">
                                        <Binding Path="ReleaseDate" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Rating -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border CornerRadius="6" 
                                    Padding="8,4" 
                                    Background="{DynamicResource PrimaryBrush}">
                                <TextBlock FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource OnPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="⭐ {0:F1}">
                                            <Binding Path="VoteAverage" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <TextBlock FontSize="14" 
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="({0} votes)">
                                        <Binding Path="VoteCount" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text=" · " 
                                       FontSize="14" 
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center" />
                            <TextBlock FontSize="14" 
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="🔥 {0:F0}">
                                        <Binding Path="Popularity" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Overview -->
                        <TextBlock Text="{Binding Overview}" 
                                   FontSize="14" 
                                   Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="80"
                                   Margin="0,12,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryBrush}" 
                Padding="32,20">
            <StackPanel>
                <TextBlock Text="🎬 Movie Catalogue" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource OnPrimaryBrush}" />
                <TextBlock Text="Discover and explore movies from The Movie Database" 
                           FontSize="16" 
                           Foreground="{DynamicResource OnPrimaryBrush}" 
                           Opacity="0.8" />
            </StackPanel>
        </Border>

        <!-- ===== SEARCH BAR ===== -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceContainerBrush}" 
                Padding="32,16" 
                BorderBrush="{DynamicResource SurfaceContainerHighBrush}" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box - Wrap TextBox in a Border for CornerRadius -->
                <Border Grid.Column="0" 
                        CornerRadius="8" 
                        BorderBrush="{DynamicResource SurfaceVariantBrush}" 
                        BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceVariantBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             FontSize="16"
                             Padding="16,12"
                             Background="Transparent"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             BorderThickness="0"
                             VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Border>

                <!-- Genre Filter -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableGenres}"
                          SelectedItem="{Binding SelectedGenre}"
                          DisplayMemberPath="Name"
                          Width="160"
                          Margin="12,0,0,0"
                          Padding="12,8"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource SurfaceBrush}"
                          Foreground="{DynamicResource OnSurfaceBrush}"
                          BorderBrush="{DynamicResource SurfaceVariantBrush}"/>

                <!-- Search Button -->
                <Button Grid.Column="2" 
                        Command="{Binding SearchCommand}"
                        Content="🔍 Search"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0"
                        Padding="24,12" />

                <!-- Trending Button -->
                <Button Grid.Column="3" 
                        Command="{Binding LoadTrendingCommand}"
                        Content="🔥 Trending"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,0,0,0"
                        Padding="24,12" />
            </Grid>
        </Border>

        <!-- ===== ADVANCED SEARCH PANEL ===== -->
        <Expander Grid.Row="2" 
                  Header="⚙️ Advanced Search" 
                  IsExpanded="{Binding IsAdvancedSearchOpen}"
                  Background="{DynamicResource SurfaceContainerBrush}"
                  Foreground="{DynamicResource OnSurfaceBrush}"
                  BorderBrush="{DynamicResource SurfaceContainerHighBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="32,8">
            <Grid Margin="0,12,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Year" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FilterYear, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             BorderBrush="{DynamicResource SurfaceVariantBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="Min Rating" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FilterMinRating, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             BorderBrush="{DynamicResource SurfaceVariantBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="Actor Name" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding FilterActorName, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource OnSurfaceBrush}"
                             BorderBrush="{DynamicResource SurfaceVariantBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8,0">
                    <TextBlock Text="Sort By" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedValue="{Binding SortBy}" 
                              SelectedValuePath="Tag" 
                              Padding="10,8"
                              Background="{DynamicResource SurfaceBrush}"
                              Foreground="{DynamicResource OnSurfaceBrush}"
                              BorderBrush="{DynamicResource SurfaceVariantBrush}">
                        <ComboBoxItem Content="Popularity" Tag="popularity.desc" IsSelected="True" />
                        <ComboBoxItem Content="Rating" Tag="vote_average.desc" />
                        <ComboBoxItem Content="Release Date" Tag="release_date.desc" />
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="4" 
                        Content="Apply Filters"
                        Command="{Binding ApplyAdvancedSearchCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="12,18,0,0"
                        Padding="20,10" 
                        VerticalAlignment="Top"/>
            </Grid>
        </Expander>

        <!-- ===== MOVIE LIST ===== -->
        <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <!-- Loading Overlay -->
            <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Wrap ProgressBar in Border for CornerRadius -->
                    <Border CornerRadius="4" 
                            Width="300" 
                            Height="8" 
                            Background="{DynamicResource SurfaceVariantBrush}"
                            ClipToBounds="True">
                        <ProgressBar IsIndeterminate="True" 
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Height="8" />
                    </Border>
                    <TextBlock Text="Loading movies..." 
                               Foreground="{DynamicResource OnSurfaceBrush}" 
                               FontSize="18" 
                               Margin="0,16,0,0"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Movie List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                <StackPanel>
                    <!-- View Mode / Results Count -->
                    <TextBlock FontSize="14" 
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                               Margin="0,0,0,16">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · Showing {1} movies">
                                <Binding Path="ViewModeLabel" />
                                <Binding Path="Movies.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Error Message -->
                    <Border Background="{DynamicResource ErrorBrush}" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " FontSize="20" />
                            <TextBlock Text="{Binding ErrorMessage}" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource OnErrorBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Empty State -->
                    <Border Margin="0,20,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Padding" Value="40" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Movies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="72" HorizontalAlignment="Center" />
                            <TextBlock Text="No movies to display" 
                                       FontSize="24" 
                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,24,0,8" />
                            <TextBlock Text="Search for a movie or click 'Trending' to get started" 
                                       FontSize="16" 
                                       Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Movie Items -->
                    <ItemsControl ItemsSource="{Binding Movies}" 
                                  ItemTemplate="{StaticResource MovieCardTemplate}" />

                    <!-- Pagination Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="DiscoverResults">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="◀ Previous" 
                                Command="{Binding PreviousPageCommand}"
                                Padding="16,8" 
                                Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding CurrentPage}" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource OnSurfaceBrush}"
                                   FontWeight="SemiBold" 
                                   Margin="8,0"/>
                        <Button Content="Next ▶" 
                                Command="{Binding NextPageCommand}"
                                Padding="16,8" 
                                Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="4" 
                Background="{DynamicResource SurfaceContainerBrush}" 
                Padding="32,12"
                BorderBrush="{DynamicResource SurfaceContainerHighBrush}" 
                BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Powered by" 
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                               FontSize="12" />
                    <TextBlock Text=" TMDb" 
                               Foreground="{DynamicResource OnSurfaceBrush}" 
                               FontSize="12" 
                               FontWeight="SemiBold" />
                    <TextBlock Text=" | " 
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                               FontSize="12" />
                    <TextBlock Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} movies loaded">
                                <Binding Path="Movies.Count" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Search: " 
                               Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                               FontSize="12" />
                    <TextBlock Text="{Binding SearchQuery, FallbackValue='(none)'}" 
                               Foreground="{DynamicResource OnSurfaceBrush}" 
                               FontSize="12" 
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>