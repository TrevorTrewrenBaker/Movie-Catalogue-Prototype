<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#FF0078D4</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryColor">#FF00BCF4</Color>
    <Color x:Key="OnSecondaryColor">#FF000000</Color>
    <Color x:Key="AccentColor">#FFD13438</Color>
    <Color x:Key="OnAccentColor">#FF000000</Color>

    <!-- Semantic Colors -->
    <Color x:Key="ErrorColor">#FFF14C4C</Color>
    <Color x:Key="OnErrorColor">#FF000000</Color>
    <Color x:Key="InfoColor">#FF00B2E8</Color>
    <Color x:Key="OnInfoColor">#FF000000</Color>
    <Color x:Key="SuccessColor">#FF30D158</Color>
    <Color x:Key="OnSuccessColor">#FF000000</Color>
    <Color x:Key="WarningColor">#FFFFD60A</Color>
    <Color x:Key="OnWarningColor">#FF000000</Color>

    <!-- Surface Colors (Tonal Elevation) -->
    <Color x:Key="BackgroundColor">#FF201F1E</Color>
    <Color x:Key="OnBackgroundColor">#FFE1DFDD</Color>
    <Color x:Key="SurfaceColor">#FF1C1B1F</Color>
    <Color x:Key="OnSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceVariantColor">#FF49454F</Color>
    <Color x:Key="OnSurfaceVariantColor">#FFE1DFDD</Color>
    <Color x:Key="SurfaceContainerLowColor">#FF2D2D2D</Color>
    <Color x:Key="SurfaceContainerColor">#FF383838</Color>
    <Color x:Key="SurfaceContainerHighColor">#FF3D3D3D</Color>
    <Color x:Key="SurfaceContainerHighestColor">#FF424242</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="OnInfoBrush" Color="{StaticResource OnInfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OnSuccessBrush" Color="{StaticResource OnSuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OnWarningBrush" Color="{StaticResource OnWarningColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}"/>

    <!-- Shadow tint -->
    <Color x:Key="ShadowTintColor">#FFE1DFDD</Color>

</ResourceDictionary>
