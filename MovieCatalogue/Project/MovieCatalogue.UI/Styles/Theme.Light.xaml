<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="PrimaryColor">#FF0078D4</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryColor">#FF00BCF4</Color>
    <Color x:Key="OnSecondaryColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#FF8F4CDB</Color>
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>

    <!-- Semantic Colors -->
    <Color x:Key="ErrorColor">#FFD13438</Color>
    <Color x:Key="OnErrorColor">#FFFFFFFF</Color>
    <Color x:Key="InfoColor">#FF0067B4</Color>
    <Color x:Key="OnInfoColor">#FFFFFFFF</Color>
    <Color x:Key="SuccessColor">#FF107C10</Color>
    <Color x:Key="OnSuccessColor">#FFFFFFFF</Color>
    <Color x:Key="WarningColor">#FFFFC107</Color>
    <Color x:Key="OnWarningColor">#FF000000</Color>

    <!-- Surface Colors (Tonal Elevation) -->
    <Color x:Key="BackgroundColor">#FFF3F2F1</Color>
    <Color x:Key="OnBackgroundColor">#FF201F1E</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="OnSurfaceColor">#FF201F1E</Color>
    <Color x:Key="SurfaceVariantColor">#FFE1DFDD</Color>
    <Color x:Key="OnSurfaceVariantColor">#FF49454F</Color>
    <Color x:Key="SurfaceContainerLowColor">#FFF9F9F9</Color>
    <Color x:Key="SurfaceContainerColor">#FFF3F2F1</Color>
    <Color x:Key="SurfaceContainerHighColor">#FFEDEBE9</Color>
    <Color x:Key="SurfaceContainerHighestColor">#FFE1DFDD</Color>

    <!-- Brushes (bind these in XAML, not the Colors above) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="OnInfoBrush" Color="{StaticResource OnInfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="OnSuccessBrush" Color="{StaticResource OnSuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OnWarningBrush" Color="{StaticResource OnWarningColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource OnBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}"/>

    <!-- Shadow tint (used by ElevationEffects.xaml) -->
    <Color x:Key="ShadowTintColor">#FF201F1E</Color>

</ResourceDictionary>
