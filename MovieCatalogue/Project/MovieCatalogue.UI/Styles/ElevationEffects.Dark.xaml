<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="Elevation0Effect" Opacity="0"/>

    <DropShadowEffect x:Key="Elevation1Effect"
                       Color="{StaticResource ShadowTintColor}"
                       ShadowDepth="0"
                       BlurRadius="8" Opacity="0.10"/>

    <DropShadowEffect x:Key="Elevation2Effect"
                       Color="{StaticResource ShadowTintColor}"
                       ShadowDepth="0"
                       BlurRadius="16" Opacity="0.12"/>

    <DropShadowEffect x:Key="Elevation3Effect"
                       Color="{StaticResource ShadowTintColor}"
                       ShadowDepth="0"
                       BlurRadius="24" Opacity="0.14"/>

    <DropShadowEffect x:Key="Elevation4Effect"
                       Color="{StaticResource ShadowTintColor}"
                       ShadowDepth="0"
                       BlurRadius="32" Opacity="0.16"/>

    <DropShadowEffect x:Key="Elevation5Effect"
                       Color="{StaticResource ShadowTintColor}"
                       ShadowDepth="0"
                       BlurRadius="40" Opacity="0.18"/>

</ResourceDictionary>
