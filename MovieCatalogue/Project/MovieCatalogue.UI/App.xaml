<Application x:Class="MovieCatalogue.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Components.xaml"/>
                <ResourceDictionary Source="Styles/ElevationEffects.Dark.xaml"/>
                <ResourceDictionary Source="Styles/ElevationEffects.Light.xaml"/>
                <ResourceDictionary Source="Styles/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Styles/Theme.Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>